# Homebrew formula for Agent Status. Generated by packaging/homebrew/update-formula.sh;
# published in the mk-quantlabs/homebrew-tap repository as Formula/agent-status.rb.
class AgentStatus < Formula
  desc "Status board for all running Claude Code sessions, with approval alerts"
  homepage "https://github.com/mk-quantlabs/claude-agent-status"
  url "https://github.com/mk-quantlabs/claude-agent-status/archive/refs/tags/v{{VERSION}}.tar.gz"
  sha256 "{{SHA256}}"
  license "MIT"

  depends_on "node"

  def install
    libexec.install Dir["*"], ".claude-plugin"
    bin.install_symlink libexec/"bin/claude-s"
    # Registers the plugin with Claude Code from opt/, which stays valid across upgrades.
    (bin/"agent-status-setup").write <<~SH
      #!/bin/bash
      AGENT_STATUS_HOME="#{opt_libexec}" exec "#{opt_libexec}/install.sh" --no-alias "$@"
    SH
    (bin/"agent-status-uninstall").write <<~SH
      #!/bin/bash
      exec "#{opt_libexec}/uninstall.sh" "$@"
    SH
  end

  def caveats
    <<~EOS
      Finish the setup (adds the plugin to Claude Code and the menu-bar icon):
        agent-status-setup

      Then start Claude as usual: claude
      After `brew upgrade agent-status` nothing else is needed: new sessions use the new
      version and the background service restarts itself.

      Before `brew uninstall agent-status`, run: agent-status-uninstall
    EOS
  end

  test do
    assert_match "claude-s", shell_output("#{bin}/claude-s help")
    system Formula["node"].opt_bin/"node", "--check", libexec/"plugins/agent-status/server/server.js"
  end
end
